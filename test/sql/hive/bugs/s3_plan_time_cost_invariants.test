# name: test/sql/hive/bugs/s3_plan_time_cost_invariants.test
# description: S3 guard - planning a Glue table samples ONE partition.
# group: [bugs]

# A per-partition sample would improve the plan while making bind time grow with the table.


require httpfs

require glue

require-env GLUE_CATALOG_ID

statement ok
attach '{GLUE_CATALOG_ID}' as my_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

statement ok
DROP TABLE IF EXISTS my_datalake.default.plancost;

statement ok
CREATE TABLE my_datalake.default.plancost (id INTEGER, dt VARCHAR) PARTITIONED BY (dt);

statement ok
INSERT INTO my_datalake.default.plancost SELECT i, 'd' || (i % 4) FROM generate_series(1,4000) t(i);

statement ok
CALL enable_logging('HTTP', storage := 'memory');

statement ok
CALL truncate_duckdb_logs();

statement ok
EXPLAIN SELECT * FROM my_datalake.default.plancost;

# planning lists exactly one partition -- four partitions, one listing
query I
SELECT count(*) FROM duckdb_logs_parsed('HTTP') WHERE request.url LIKE '%list-type=2%';
----
1

# and asks Glue exactly twice: the table definition, and the partition list
query II
SELECT request.headers['x-amz-target'], count(*) FROM duckdb_logs_parsed('HTTP')
WHERE request.headers['x-amz-target'] IS NOT NULL GROUP BY 1 ORDER BY 1;
----
AWSGlue.GetPartitions	1
AWSGlue.GetTable	1

statement ok
DROP TABLE my_datalake.default.plancost;

# ----------------------------------------------------------------------------------------------------
# THE GUARD: the sample must not grow with the table.
# ----------------------------------------------------------------------------------------------------
statement ok
DROP TABLE IF EXISTS my_datalake.default.plancost_wide;

statement ok
CREATE TABLE my_datalake.default.plancost_wide (id INTEGER, dt VARCHAR) PARTITIONED BY (dt);

statement ok
INSERT INTO my_datalake.default.plancost_wide SELECT i, 'd' || (i % 20) FROM generate_series(1,4000) t(i);

query I
SELECT count(*) FROM glue_partitions('my_datalake.default.plancost_wide');
----
20

statement ok
CALL truncate_duckdb_logs();

statement ok
EXPLAIN SELECT * FROM my_datalake.default.plancost_wide;

# still ONE listing, for five times the partitions
query I
SELECT count(*) FROM duckdb_logs_parsed('HTTP') WHERE request.url LIKE '%list-type=2%';
----
1

query II
SELECT request.headers['x-amz-target'], count(*) FROM duckdb_logs_parsed('HTTP')
WHERE request.headers['x-amz-target'] IS NOT NULL GROUP BY 1 ORDER BY 1;
----
AWSGlue.GetPartitions	1
AWSGlue.GetTable	1

statement ok
DROP TABLE my_datalake.default.plancost_wide;
